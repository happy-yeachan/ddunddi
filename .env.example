# 이 파일은 형식만 보여줍니다. 실제 값은 .env.local 에 직접 채우세요 (git 에 올라가지 않습니다).
# Vercel 에 배포할 때는 Project → Settings → Environment Variables 에도 같은 값을 넣어야 합니다.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → Publishable key (예전 이름: anon / public)
# 브라우저에 노출되는 키입니다. service_role 키는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 두 사람이 정하는 공유 비밀번호. 서버에서만 읽습니다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 그대로 박히니 붙이지 마세요.
GATE_PASSWORD=
